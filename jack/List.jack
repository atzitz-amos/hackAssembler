
/**
* Represents a dynamically resizing array
*
* Thanks to the loose typing of Jack, it can be used interchangeably with the built-in Array type
* The other way around is not possible though, as there is no way to access a traditional Array's length
*/
class List {

    function List new(int length) {
        // Abuse of the non-type checking nature of Jack, so that it behaves like a traditional array
        var Array arr;

        let arr = Memory.alloc(length + 2);
        if (length = 0) {
            let arr[0] = 1;
        } else {
            let arr[0] = length;  // arr[-2] is the capacity
        }
        let arr[1] = length;  // arr[-1] is the length
        return arr + 2;  // Return the address of the first element
    }

    /**
    * Size-safe array access
    */
    method Array getElement(int index) {
        var Array obj;

        if ((index < 0) | (index > length())) {
            do Output.printString("[Fatal] Array index out of bounds: ");
            do Output.printInt(index);
            do Sys.halt();
            return 0;
        }
        let obj = this;  // Apparently the compiler doesn't understand operations on `this`
        return obj[index];
    }

    /**
    * Size-safe array access
    */
    method void setElement(int index, int value) {
        var Array obj;

        if ((index < 0) | (index > length())) {
            do Output.printString("[Fatal] Array index out of bounds: ");
            do Output.printInt(index);
            do Sys.halt();
            return;
        }
        let obj = this;
        let obj[index] = value;
        return;
    }

    /**
    * Append a value to the end of the array, resizing if necessary
    * We must return the new array, as Jack does not support pass-by-reference
    */
    method List append(int value) {
        var Array obj;

        let obj = this;

        if (~(length() < capacity())) {
            let obj = resize();
        }
        let obj[length()] = value;
        let obj[-1] = length() + 1;

        return obj;
    }

    /**
    * Pop the last element off the array
    * This actually just decrements the length, so the value is still there
    */
    method Array pop() {
        var Array obj;

        let obj = this;
        let obj[-1] = length() - 1;
        return obj[length()];
    }

    /**
    * Resize the array to double its current capacity
    * We must return the new array, as Jack does not support pass-by-reference
    */
    method List resize() {
        var int newCapacity;
        var Array newArr, oldArr;

        let newCapacity = capacity() * 2;
        let newArr = Memory.alloc(newCapacity + 2);
        let newArr[0] = newCapacity;
        let newArr[1] = length();

        let oldArr = this;
        do List.copy(oldArr, newArr + 2);  // Extremely dubious type casting, but it works
        do oldArr.dispose();

        return newArr + 2;
    }

    /**
    * Copy the contents of one array to another
    * Both arrays must be Lists, to copy Arrays use `copyArray` instead
    */
    function void copy(List src, List dest) {
        var int length;

        let length = Math.min(src.length(), dest.length());

        do List.copyArray(src, dest, length);  // Again, loose type casting
        return;
    }

    /**
    * Copy the contents of one array to another
    */
    function void copyArray(Array src, Array dest, int length) {
        var int i;

        let i = 0;
        while (i < length) {
            let dest[i] = src[i];
            let i = i + 1;
        }
        return;
    }

    /**
    * Slice array
    */
    method List slice(int start, int end) {
        var int i;
        var List oldArr, newArr;

        let oldArr = this;
        let newArr = List.new(end - start);

        do List.copyArray(oldArr + start, newArr, end - start);
        return newArr;
    }

    /**
    * Get first
    */
    method Array getFirst() {
        var Array obj;
        let obj = this;
        return obj[0];
    }

    /**
    * Get last
    */
    method Array getLast() {
        var Array obj;
        let obj = this;
        return obj[length() - 1];
    }

    /**
    * Array to List conversion
    */
    function List fromArray(Array arr, int length) {
        var int i;
        var List newArr;

        let newArr = List.new(length);
        do List.copyArray(arr, newArr, length);
        return newArr;
    }

    /**
    * Print the array to the screen
    */
    method void print() {
        var Array obj;
        var int i;

        if (length() = 0) {
            do Output.printString("[]");
            return;
        }

        let obj = this;
        let i = 0;
        do Output.printString("[");
        while (i < length()) {
            do Output.printInt(obj[i]);
            do Output.printString(",");
            let i = i + 1;
        }
        do Output.backSpace();
        do Output.printString("]");
        return;
    }

    /**
    * Print a string array to the screen
    */
    method void printStringArray() {
        var Array obj;
        var int i;

        let obj = this;
        let i = 0;
        do Output.printString("[");
        while (i < length()) {
            do Output.printString(obj[i]);
            do Output.printString(",");
            let i = i + 1;
        }
        do Output.backSpace();
        do Output.printString("]");
        return;
    }

    method int length() {
        var Array obj;
        let obj = this;
        return obj[-1];
    }
    method int capacity() {
        var Array obj;
        let obj = this;
        return obj[-2];
    }

    method void dispose() {
        var Array obj;
        let obj = this;
        do Memory.deAlloc(obj - 2);  // Object actually starts at this - 2
        return;
    }
}