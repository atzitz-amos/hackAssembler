

class BetterString {
    field String string;

    constructor BetterString new(String base) {
        let string = base;
        return this;
    }

    // -----------------------------------------
    method int count(BetterString sub) {
        return countString(sub.toString());
    }

    // Internal function
    // Necessary, because there is no break in jack
    function int __kmp_table_update_table(String sub, int pos, int cnd, Array table) {
        while (~(cnd < 0)) {
            if (sub.charAt(pos) = sub.charAt(cnd)) {
                return cnd;
            }
            let cnd = table[cnd];
        }
        return cnd;
    }

    method int countString(String sub) {
        var int i, m, pos, cnd;
        var Array table;
        var int result;

        let i = 0;
        let m = 0;

        // Build table

        let table = Array.new(sub.length()+1);
        let pos = 1;
        let table[0] = -1;
        while (pos < sub.length()) {
            if (sub.charAt(pos) = sub.charAt(cnd)) {
                let table[pos] = table[cnd];
            } else {
                let table[pos] = cnd;
                let cnd = BetterString.__kmp_table_update_table(sub, pos, cnd, table);
            }
            let pos = pos + 1;
            let cnd = cnd + 1;
        }

        // Search
        while ((i + m) < string.length()) {
            if (BetterString.charAtOf(sub, i) = BetterString.charAtOf(string, i + m)) {
                if (i = (sub.length()-1)) {
                    let result = result + 1;
                    let m = m + i - table[i];
                    let i = table[i];
                } else {
                    let i = i + 1;
                }
            } else {
                let m = m + i - table[i];
                if (table[i] > -1) {
                    let i = table[i];
                } else {
                    let i = 0;
                }
            }
        }

        do table.dispose();

        return result;
    }

    /*
    * Split a string according to `sep`
    * Returns `BetterString``
    */
    method List splitString(String sep) {
        var List result, indexMap;
        var int length, i, last;

        let length = countString(sep);
        let indexMap = findAll(sep);
        let result = List.new(length+1);

        let i = 0;
        let last = 0;
        while (i < length) {
            let result[i] = substring(last, indexMap[i]);

            let last = indexMap[i] + sep.length();
            let i = i + 1;
        }

        if (~(last > string.length())) {
            let result[i] = substring(last, string.length());
        }

        do indexMap.dispose();

        return result;
    }

    method List split(BetterString sep) {
        return splitString(sep.toString());
    }

    // -----------------------------------------
    method String substring(int start, int end) {
        var int i;
        var String result;

        let i = start;
        let result = String.new(end - start);

        while (i < end) {
            let result = result.appendChar(string.charAt(i));
            let i = i + 1;
        }

        return result;
    }

    /**
    * Find all occurrences of `sub` in `string`
    */
    method List findAll(String sub) {
        var int i, m, pos, cnd;
        var Array table;
        var List result;

        let result = List.new(0);

        let i = 0;
        let m = 0;

        // Build table

        let table = Array.new(sub.length()+1);
        let pos = 1;
        let table[0] = -1;
        while (pos < sub.length()) {
            if (sub.charAt(pos) = sub.charAt(cnd)) {
                let table[pos] = table[cnd];
            } else {
                let table[pos] = cnd;
                let cnd = BetterString.__kmp_table_update_table(sub, pos, cnd, table);
            }
            let pos = pos + 1;
            let cnd = cnd + 1;
        }
        let table[pos] = cnd;

        // Search
        while ((i + m) < string.length()) {
            if (BetterString.charAtOf(sub, i) = BetterString.charAtOf(string, i + m)) {
                if (i = (sub.length()-1)) {
                    let result = result.append(m);
                    let m = m + i - table[i];
                    let i = table[i];
                } else {
                    let i = i + 1;
                }
            } else {
                let m = m + i - table[i];
                if (table[i] > -1) {
                    let i = table[i];
                } else {
                    let i = 0;
                }
            }
        }

        do table.dispose();

        return result;
    }
    // -----------------------------------------
    method String concatString(String other) {
        var int length1, length2, location;
        var String result;

        let location = 0;
        let length1 = string.length();
        let length2 = other.length();

        let result = String.new(length1 + length2);

        while (length1 > location) {
            let result = result.appendChar(string.charAt(location));
            let location = location + 1;
        }
        let location = 0;
        while (length2 > location) {
            let result = result.appendChar(other.charAt(location));
            let location = location + 1;
        }

        return result;
    }

    method BetterString concat(BetterString other) {
        return BetterString.new(concatString(other.toString()));
    }

    // -----------------------------------------
    method char charAt(int i) {
        return BetterString.charAtOf(string, i);
    }

    function char charAtOf(String s, int i) {
        if (i < 0) {
            let i = i + s.length();
        }
        return s.charAt(i);
    }
    method int getLength() {return string.length();}

    method String toString() {return string;}

    function boolean isSame(String a, String b) {
        var int i;
        if (a.length() = b.length()) {
            let i = 0;
            while (i < a.length()) {
                if (a.charAt(i) = b.charAt(i)) {
                    let i = i + 1;
                } else {
                    return false;
                }
            }
            return true;
        } else {
            return false;
        }
    }

    /** convert BetterString to char Array. */
    method List toCharArray() {
        var List array;
        var int i, length;

        let length = getLength();
        let array = List.new(length);
        let i = 0;
        while (i < length) {
            let array[i] = string.charAt(i);
            let i = i + 1;
        }

        return array;
    }

    /** prints BetterString value to the screen. */
    method void print() {
        do Output.printString(string);
        return;
    }

    method void dispose() {
        do string.dispose();
        return;
    }
}